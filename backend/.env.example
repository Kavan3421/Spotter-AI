# ==========================================
# Spotter AI - Supabase PostgreSQL Configuration
# ==========================================

# Paste your Supabase Database URI below.
# Where to find it in Supabase:
# 1. Open your project on https://supabase.com/dashboard
# 2. Go to Project Settings -> Database
# 3. Under "Connection string", select "URI"
# 4. Replace [YOUR-PASSWORD] with your actual Supabase database password

# Direct Connection (Port 5432):
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Or Transaction Pooler (Port 6543 - Recommended for IPv4 / Serverless):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

DJANGO_SECRET_KEY=spotter-ai-commercial-hos-secret-key-production-ready
DEBUG=True
