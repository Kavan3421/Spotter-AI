# ====================================
# Spotter AI - Root Git Ignore
# ====================================

# -----------------
# Environment & Secrets (Never commit credentials!)
# -----------------
.env
.env.*
!.env.example
*.env

# -----------------
# Backend (Python / Django)
# -----------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# SQLite / Local Databases
*.sqlite3
*.sqlite3-journal
backend/db.sqlite3
backend/db.sqlite3-journal

# Django static & media uploads
backend/staticfiles/
backend/media/

# -----------------
# Frontend (Node / React / Vite)
# -----------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/

# NPM / Yarn / PNPM logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------
# System & Editor Artifacts
# -----------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
